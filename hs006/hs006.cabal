cabal-version:      3.14
name:               hs006
version:            0.1.0.0
license:            NONE
author:             ueki5
maintainer:         ueki005@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

common language
    default-language: GHC2024
    build-depends:    base >=4.20 && <4.21

-- ~/.ghci の interactive-print と、デバッグ中の Pretty Print（nvim-dap）で pretty-simple を使う
common debug
    build-depends:    pretty-simple

library
    import:           warnings, language, debug
    exposed-modules:  Compiler, CodeGen
    hs-source-dirs:   src

executable hs006
    import:           warnings, language, debug
    main-is:          Main.hs
    build-depends:
        hs006,
        optparse-applicative,
        process,
        directory,
        filepath
    hs-source-dirs:   app

test-suite hs006-test
    import:           warnings, language, debug
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        hs006,
        hspec,
        process,
        temporary,
        filepath
    hs-source-dirs:   test
