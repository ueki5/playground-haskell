cabal-version:      3.14
name:               hs008
version:            0.1.0.0
license:            NONE
author:             ueki5
maintainer:         ueki005@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Calc
    build-depends:
        base >=4.19.2.0 && <4.21,
        pretty-simple,
        mtl
    hs-source-dirs:   src
    default-language: Haskell2010

executable hs008
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base >=4.19.2.0 && <4.21,
        pretty-simple,
        mtl,
        hs008
    hs-source-dirs:   app
    default-language: Haskell2010

test-suite hs008-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base >=4.19.2.0 && <4.21,
        hs008,
        pretty-simple,
        mtl,
        hspec
    hs-source-dirs:   test
    default-language: Haskell2010
