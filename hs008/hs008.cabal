cabal-version:      3.14
name:               hs008
version:            0.1.0.0
license:            NONE
author:             ueki5
maintainer:         ueki005@gmail.com
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

common language
    default-language: GHC2024

library
    import:           warnings, language
    exposed-modules:  Calc, Util
    build-depends:
        base >=4.20 && <4.21,
        pretty-simple,
        mtl
    hs-source-dirs:   src

executable hs008
    import:           warnings, language
    main-is:          Main.hs
    build-depends:
        base >=4.20 && <4.21,
        pretty-simple,
        mtl,
        hs008
    hs-source-dirs:   app

test-suite hs008-test
    import:           warnings, language
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base >=4.20 && <4.21,
        hs008,
        pretty-simple,
        mtl,
        hspec
    hs-source-dirs:   test
